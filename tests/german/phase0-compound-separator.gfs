cc -all "Ordinary noun separator:" ++ (mkN "Testkern" "Testkern" "Testkern" "Testkerns" "Testkerne" "Testkernen" masculine).s ! Sg ! Nom ++ (mkN "Testkern" "Testkern" "Testkern" "Testkerns" "Testkerne" "Testkernen" masculine).uncap.s ! Sg ! Nom ++ (mkN "Testkern" "Testkern" "Testkern" "Testkerns" "Testkerne" "Testkernen" masculine).co ++ (mkN "Testkern" "Testkern" "Testkern" "Testkerns" "Testkerne" "Testkernen" masculine).uncap.co ++ case (mkN "Testkern" "Testkern" "Testkern" "Testkerns" "Testkerne" "Testkernen" masculine).csep of {BindSep => "bind" ; HyphenSep => "hyphen"} ++ case (mkN "Testkern" "Testkern" "Testkern" "Testkerns" "Testkerne" "Testkernen" masculine).g of {Masc => "masculine" ; _ => "wrong"}
cc -all "Abbreviation record:" ++ (abbrevN (invarN "ABC" neuter)).s ! Sg ! Nom ++ (abbrevN (invarN "ABC" neuter)).s ! Sg ! Gen ++ (abbrevN (invarN "ABC" neuter)).s ! Pl ! Dat ++ (abbrevN (invarN "ABC" neuter)).uncap.s ! Sg ! Nom ++ (abbrevN (invarN "ABC" neuter)).uncap.s ! Sg ! Gen ++ (abbrevN (invarN "ABC" neuter)).uncap.s ! Pl ! Dat ++ (abbrevN (invarN "ABC" neuter)).co ++ (abbrevN (invarN "ABC" neuter)).uncap.co ++ case (abbrevN (invarN "ABC" neuter)).csep of {HyphenSep => "hyphen" ; BindSep => "bind"} ++ case (abbrevN (invarN "ABC" neuter)).g of {Neutr => "neuter" ; _ => "wrong"}
