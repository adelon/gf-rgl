cc -all "Forced hyphen other:" ++ (mkHyphenN "ABC" (mkN "Testkern" "Testkern" "Testkern" "Testkerns" "Testkerne" "Testkernen" masculine)).co ++ (mkHyphenN "ABC" (mkN "Testkern" "Testkern" "Testkern" "Testkerns" "Testkerne" "Testkernen" masculine)).uncap.co ++ case (mkHyphenN "ABC" (mkN "Testkern" "Testkern" "Testkern" "Testkerns" "Testkerne" "Testkernen" masculine)).csep of {HyphenSep => "hyphen" ; BindSep => "bind"} ++ case (mkHyphenN "ABC" (mkN "Testkern" "Testkern" "Testkern" "Testkerns" "Testkerne" "Testkernen" masculine)).g of {Masc => "masculine" ; _ => "wrong"}
