cc -all "Explicit plural uncap.s:" ++ (mkN "Testlexikon" "Testlexika" neuter).uncap.s ! Sg ! Nom ++ (mkN "Testlexikon" "Testlexika" neuter).uncap.s ! Sg ! Acc ++ (mkN "Testlexikon" "Testlexika" neuter).uncap.s ! Sg ! Dat ++ (mkN "Testlexikon" "Testlexika" neuter).uncap.s ! Sg ! Gen ++ (mkN "Testlexikon" "Testlexika" neuter).uncap.s ! Pl ! Nom ++ (mkN "Testlexikon" "Testlexika" neuter).uncap.s ! Pl ! Acc ++ (mkN "Testlexikon" "Testlexika" neuter).uncap.s ! Pl ! Dat ++ (mkN "Testlexikon" "Testlexika" neuter).uncap.s ! Pl ! Gen
