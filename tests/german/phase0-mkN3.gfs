cc -all "Three-part mkN uncap.s:" ++ (mkN "Testsprache" "Testsprachen" "Testsprach" feminine).uncap.s ! Sg ! Nom ++ (mkN "Testsprache" "Testsprachen" "Testsprach" feminine).uncap.s ! Sg ! Acc ++ (mkN "Testsprache" "Testsprachen" "Testsprach" feminine).uncap.s ! Sg ! Dat ++ (mkN "Testsprache" "Testsprachen" "Testsprach" feminine).uncap.s ! Sg ! Gen ++ (mkN "Testsprache" "Testsprachen" "Testsprach" feminine).uncap.s ! Pl ! Nom ++ (mkN "Testsprache" "Testsprachen" "Testsprach" feminine).uncap.s ! Pl ! Acc ++ (mkN "Testsprache" "Testsprachen" "Testsprach" feminine).uncap.s ! Pl ! Dat ++ (mkN "Testsprache" "Testsprachen" "Testsprach" feminine).uncap.s ! Pl ! Gen
cc -all "Three-part mkN other:" ++ (mkN "Testsprache" "Testsprachen" "Testsprach" feminine).co ++ (mkN "Testsprache" "Testsprachen" "Testsprach" feminine).uncap.co ++ case (mkN "Testsprache" "Testsprachen" "Testsprach" feminine).g of {Fem => "feminine" ; _ => "wrong"}
cc -all "Three-part mkN composition:" ++ (mkN (mkN "Testsprache" "Testsprachen" "Testsprach" feminine) (mkN "Modell" "Modelle" neuter)).s ! Sg ! Nom ++ (mkN (mkN "Testsprache" "Testsprachen" "Testsprach" feminine) (mkN "Modell" "Modelle" neuter)).s ! Pl ! Nom ++ (mkN (mkN "Testsprache" "Testsprachen" "Testsprach" feminine) (mkN "Modell" "Modelle" neuter)).s ! Pl ! Dat
