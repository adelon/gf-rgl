i -retain alltenses/ParadigmsGer.gfo

cc -all "Present 2sg:" ++ (mk6V "halten" "hält" "halt" "hielt" "hielte" "gehalten").s ! (VFin False (VPresInd Sg P2)) ++ (mk6V "waschen" "wäscht" "wasch" "wusch" "wüsche" "gewaschen").s ! (VFin False (VPresInd Sg P2)) ++ (mk6V "arbeiten" "arbeitet" "arbeite" "arbeitete" "arbeitete" "gearbeitet").s ! (VFin False (VPresInd Sg P2)) ++ (mk6V "sitzen" "sitzt" "sitz" "saß" "säße" "gesessen").s ! (VFin False (VPresInd Sg P2)) ++ (irregV "können" "kann" "konnte" "könnte" "gekonnt").s ! (VFin False (VPresInd Sg P2)) ++ (irregV "werden" "wird" "wurde" "würde" "geworden").s ! (VFin False (VPresInd Sg P2))
cc -all "Preterite 2sg:" ++ (mk6V "halten" "hält" "halt" "hielt" "hielte" "gehalten").s ! (VFin False (VImpfInd Sg P2)) ++ (mk6V "waschen" "wäscht" "wasch" "wusch" "wüsche" "gewaschen").s ! (VFin False (VImpfInd Sg P2)) ++ (mk6V "arbeiten" "arbeitet" "arbeite" "arbeitete" "arbeitete" "gearbeitet").s ! (VFin False (VImpfInd Sg P2)) ++ (mk6V "sitzen" "sitzt" "sitz" "saß" "säße" "gesessen").s ! (VFin False (VImpfInd Sg P2))
cc -all "Prefixed 2sg:" ++ (prefixV "zurück" (mk6V "treten" "tritt" "tritt" "trat" "träte" "getreten")).s ! (VFin True (VPresInd Sg P2)) ++ (prefixV "zurück" (mk6V "treten" "tritt" "tritt" "trat" "träte" "getreten")).s ! (VFin True (VImpfInd Sg P2))
