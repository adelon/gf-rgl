i -retain alltenses/ParadigmsGer.gfo

cc -all (mkN "Sprache" "Sprachen" "Sprach" feminine).s ! Sg ! Nom ++ (mkN "Sprache" "Sprachen" "Sprach" feminine).s ! Pl ! Nom ++ (mkN "Sprache" "Sprachen" "Sprach" feminine).s ! Pl ! Dat ++ (mkN "Sprache" "Sprachen" "Sprach" feminine).co ++ (mkN "Sprache" "Sprachen" "Sprach" feminine).uncap.co
cc -all case (mkN "Sprache" "Sprachen" "Sprach" feminine).g of {Fem => "feminine" ; _ => "wrong"}
cc -all (mkN "Sprache" "Sprachen" feminine).co ++ (mkN "Sprache" "Sprachen" feminine).uncap.co
cc -all (mkN (changeCompoundN "Ampere" (mkN "Ampere" "Ampere" neuter)) (mkN "Meter" "Meter" neuter)).s ! Sg ! Nom
cc -all (dative_eN (changeCompoundN "Tages" (mkN "Tag" "Tag" "Tag" "Tages" "Tage" "Tagen" masculine))).s ! Sg ! Dat ++ (dative_eN (changeCompoundN "Tages" (mkN "Tag" "Tag" "Tag" "Tages" "Tage" "Tagen" masculine))).uncap.s ! Sg ! Dat ++ (mkN "Feier" (dative_eN (changeCompoundN "Tages" (mkN "Tag" "Tag" "Tag" "Tages" "Tage" "Tagen" masculine)))).s ! Sg ! Nom ++ (mkN "Feier" (dative_eN (changeCompoundN "Tages" (mkN "Tag" "Tag" "Tag" "Tages" "Tage" "Tagen" masculine)))).s ! Sg ! Dat ++ (dative_eN (changeCompoundN "Tages" (mkN "Tag" "Tag" "Tag" "Tages" "Tage" "Tagen" masculine))).co ++ (dative_eN (changeCompoundN "Tages" (mkN "Tag" "Tag" "Tag" "Tages" "Tage" "Tagen" masculine))).uncap.co

i -retain alltenses/ExtendGer.gfo

cc -all (ExtendGer.CompoundN (ParadigmsGer.mkN "Sprache" "Sprachen" "Sprach" ParadigmsGer.feminine) (ParadigmsGer.mkN "Familie" "Familien" ParadigmsGer.feminine)).s ! Sg ! Nom
cc -all case (ExtendGer.CompoundN (ParadigmsGer.changeCompoundN "Friedhofs" (ParadigmsGer.mkN "Friedhof" "Friedhöfe" ParadigmsGer.masculine)) (ParadigmsGer.mkN "Mauer" "Mauern" ParadigmsGer.feminine)).g of {ResGer.Fem => "feminine" ; _ => "wrong"}
cc -all (ExtendGer.CompoundAP (ParadigmsGer.changeCompoundN "Friedhofs" (ParadigmsGer.mkN "Friedhof" "Friedhöfe" ParadigmsGer.masculine)) (ParadigmsGer.mkA "nah")).s ! ResGer.APred

i -retain alltenses/LexiconGer.gfo

cc -all cheese_N.co ++ cheese_N.uncap.co ++ industry_N.co ++ industry_N.uncap.co ++ school_N.co ++ school_N.uncap.co
cc -all seed_N.co ++ seed_N.uncap.co ++ knee_N.co ++ knee_N.uncap.co ++ snow_N.co ++ snow_N.uncap.co
cc -all (ParadigmsGer.mkN seed_N bank_N).s ! ParadigmsGer.singular ! ParadigmsGer.nominative ++ (ParadigmsGer.mkN knee_N (ParadigmsGer.mkN "Gelenk" "Gelenke" ParadigmsGer.neuter)).s ! ParadigmsGer.singular ! ParadigmsGer.nominative ++ (ParadigmsGer.mkN knee_N (ParadigmsGer.mkN "Scheibe" "Scheiben" ParadigmsGer.feminine)).s ! ParadigmsGer.singular ! ParadigmsGer.nominative ++ (ParadigmsGer.mkN snow_N (ParadigmsGer.mkN "Ball" "Bälle" ParadigmsGer.masculine)).s ! ParadigmsGer.singular ! ParadigmsGer.nominative

