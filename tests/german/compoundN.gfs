i -retain alltenses/ParadigmsGer.gfo

cc -all (mkN "Sprache" "Sprachen" "Sprach" feminine).s ! Sg ! Nom ++ (mkN "Sprache" "Sprachen" "Sprach" feminine).s ! Pl ! Nom ++ (mkN "Sprache" "Sprachen" "Sprach" feminine).s ! Pl ! Dat ++ (mkN "Sprache" "Sprachen" "Sprach" feminine).co ++ (mkN "Sprache" "Sprachen" "Sprach" feminine).uncap.co
cc -all case (mkN "Sprache" "Sprachen" "Sprach" feminine).g of {Fem => "feminine" ; _ => "wrong"}
cc -all (mkN "Sprache" "Sprachen" feminine).co ++ (mkN "Sprache" "Sprachen" feminine).uncap.co
cc -all (mkN (changeCompoundN "Ampere" (mkN "Ampere" "Ampere" neuter)) (mkN "Meter" "Meter" neuter)).s ! Sg ! Nom

i -retain alltenses/ExtendGer.gfo

cc -all (ExtendGer.CompoundN (ParadigmsGer.mkN "Sprache" "Sprachen" "Sprach" ParadigmsGer.feminine) (ParadigmsGer.mkN "Familie" "Familien" ParadigmsGer.feminine)).s ! Sg ! Nom

i -retain alltenses/LexiconGer.gfo

cc -all cheese_N.co ++ cheese_N.uncap.co ++ industry_N.co ++ industry_N.uncap.co ++ school_N.co ++ school_N.uncap.co

i -retain alltenses/DictGer.gfo

cc -all sprache_N.co ++ (ParadigmsGer.mkN sprache_N politik_N).s ! ParadigmsGer.singular ! ParadigmsGer.nominative ++ sprachpolitik_N.s ! ParadigmsGer.singular ! ParadigmsGer.nominative ++ sprachenpolitik_N.s ! ParadigmsGer.singular ! ParadigmsGer.nominative
cc -all wache_N.co ++ (ParadigmsGer.mkN wache_N turm_N).s ! ParadigmsGer.singular ! ParadigmsGer.nominative ++ wachturm_N.s ! ParadigmsGer.singular ! ParadigmsGer.nominative ++ wachtturm_N.s ! ParadigmsGer.singular ! ParadigmsGer.nominative
cc -all DictGer.bilge_N.co
cc -all braunkohle_N.co ++ braunkohle_N.uncap.co ++ (ParadigmsGer.mkN braunkohle_N kraftwerk_N).s ! ParadigmsGer.singular ! ParadigmsGer.nominative ++ stammzelle_N.co ++ stammzelle_N.uncap.co ++ (ParadigmsGer.mkN stammzelle_N faktor_N).s ! ParadigmsGer.singular ! ParadigmsGer.nominative ++ steinkohle_N.co ++ steinkohle_N.uncap.co ++ (ParadigmsGer.mkN steinkohle_N kraftwerk_N).s ! ParadigmsGer.singular ! ParadigmsGer.nominative
cc -all kaese_N.co ++ kaese_N.uncap.co ++ frischkaese_N.co ++ frischkaese_N.uncap.co
cc -all gebaeude_N.co ++ gebaeude_N.uncap.co ++ wohngebaeude_N.co ++ wohngebaeude_N.uncap.co
cc -all (ParadigmsGer.mkN frischkaese_N kuchen_N).s ! ParadigmsGer.singular ! ParadigmsGer.nominative
cc -all (ParadigmsGer.mkN kaese_N kuchen_N).co
cc -all (ParadigmsGer.mkN gebaeude_N teil_N).co
cc -all (ParadigmsGer.mkN kirche_N tuer_N).co
cc -all (ParadigmsGer.mkN auge_N arzt_N).co
cc -all messwein_N.s ! ParadigmsGer.singular ! ParadigmsGer.nominative ++ (ParadigmsGer.mkN rasse_N hund_N).s ! ParadigmsGer.singular ! ParadigmsGer.nominative
cc -all algonkin_sprache_N.s ! ParadigmsGer.singular ! ParadigmsGer.nominative ++ (ParadigmsGer.mkN algonkin_sprache_N familie_N).s ! ParadigmsGer.singular ! ParadigmsGer.nominative
